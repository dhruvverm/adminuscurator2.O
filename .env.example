# ─────────────────────────────────────────────────────────────
# Copy to .env.local and fill in. Never commit real secrets.
# ─────────────────────────────────────────────────────────────

# Public URL of the site (used for canonical URLs, sitemap, OAuth + Stripe redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secret used to sign session cookies. Generate with:  openssl rand -base64 32
AUTH_SECRET=

# First administrator. Created automatically on first start if no admin exists.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Google OAuth (optional — the "Continue with Google" button only appears when set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Payments (Stripe). Leave empty to use demo checkout in development.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe Price IDs for each plan + billing interval
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_PROFESSIONAL_MONTHLY=
STRIPE_PRICE_PROFESSIONAL_YEARLY=
# Allow demo checkout (no real payment) — never enable in production
PAYMENTS_DEMO_MODE=true

# ── Analytics (all optional; nothing loads until the visitor accepts analytics cookies)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
